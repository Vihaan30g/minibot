<!--
  ================================================================
  MiniBot – MINIMAL TF-ONLY URDF (for SLAM tuning)
  ================================================================
  Purpose: nothing but the base_footprint -> base_link frame chain.
  No wheels, no chassis, no visual/collision geometry, and — on
  purpose — NO camera link either.

  The ZED2i's own frames (zed_camera_link, zed_camera_center, the
  left/right optical frames, imu_link, etc.) are published by the
  ZED wrapper's OWN robot_state_publisher when you launch
  `zed_wrapper zed_camera.launch.py`. That subtree is rooted at
  <camera_name>_camera_link (default: "zed_camera_link").

  Since zed-ros2-wrapper v4.0.8, the wrapper intentionally does NOT
  publish the base_link -> camera_link transform anymore, precisely
  so each robot can supply it however fits their setup. Here, that
  single link is provided by a `static_transform_publisher` node in
  the launch file below — NOT by adding a camera link into this URDF.
  Do not add a zed_camera_link (or any camera link) to this file:
  two robot_state_publishers both claiming the same link name will
  fight over it in TF and one of the mounts will "flicker"/jump.
  ================================================================
-->
<robot name="minibot_slam_minimal">
  <!-- base_footprint: virtual ground-projection frame (REP-105).
       No geometry, no inertia — purely a TF anchor. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <!-- base_link: also just a TF anchor here — no geometry, no inertia.
       This is fine for pure SLAM/TF tuning; add mass/inertia back in
       only if you plan to use this same file with Gazebo physics. -->
  <link name="base_link"/>
</robot>
